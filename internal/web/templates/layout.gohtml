{{- /*
  The page frame: account list on the left, page content on the right, and the
  database this window is editing named along the bottom (SPECIFICATION.md BK-3).

  There is no JavaScript here yet. Everything on these pages is a link, and a
  link already does what a script would have to be written to do. HTMX comes in
  when the register grows interactions -- marking a row cleared, editing in
  place -- that genuinely need part of a page replaced (TS-1, TS-4).
*/ -}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}} &middot; Checkbook</title>
    <link rel="stylesheet" href="/static/app.css">
    {{- /* htmx, vendored and served from loopback. It is never a CDN reference:
           the register has to run with no network at all (PL-3, TS-4). See
           internal/web/htmx.md for the version, hash, and licence.

           Everything it drives is a real form that works without it. The script
           makes marking a row cleared replace that row instead of the page; if
           it fails to load, the same form posts and the page reloads. */ -}}
    <script src="/static/htmx.min.js" defer></script>
</head>
<body{{if .Ephemeral}} class="ephemeral"{{else if .ReadOnly}} class="readonly"{{end}}>
{{- /* A database held in memory is marked wherever the frame is: at the top,
       where somebody about to type looks, and at the bottom beside the path,
       where they look to see which file they are editing. A register that keeps
       nothing must not look like one that does. The hourglass is a placeholder
       for a better mark. */ -}}
<header class="topbar">
    <a class="brand" href="/">Checkbook</a>
    {{if .Ephemeral}}
        <span class="temporary" title="Sample data held in memory. It is discarded when the program stops, and nothing is written to disk.">
            <span aria-hidden="true">&#8987;</span> Demo &mdash; nothing is saved
        </span>
    {{else if .IsBackup}}
        {{- /* A backup. Named as one rather than described as read-only,
               because "this is a backup" is the fact that decides what the
               reader does next: close it, or restore it. */ -}}
        <span class="locked" title="A backup. It is opened for reading automatically and never written to: the moment it were, it would stop being the copy that was taken.">
            <span aria-hidden="true">&#128274;</span> Backup &mdash; nothing can be changed
        </span>
    {{else if .ReadOnly}}
        {{- /* A checkbook opened for reading. Marked in the frame for the same
               reason the demo is: a register that cannot be written to looks
               exactly like one that can until somebody tries. */ -}}
        <span class="locked" title="Opened for reading only. Nothing here can be changed.">
            <span aria-hidden="true">&#128274;</span> Read-only &mdash; nothing can be changed
        </span>
    {{end}}
</header>

<div class="shell">
    {{- /* One column holding both sections: the accounts, and what can be done
           to the checkbook they are in. */ -}}
    <div class="sidebar">
    <nav class="accounts" aria-label="Accounts">
        <h2>Accounts</h2>
        {{if .Accounts}}
            <ul>
                {{range .Accounts}}
                    <li>
                        <a href="/accounts/{{.ID}}"
                           class="{{if eq .ID $.ActiveID}}active{{end}}"
                           {{if eq .ID $.ActiveID}}aria-current="page"{{end}}>
                            {{.Name}}{{if .IsClosed}} <span class="closed" title="Closed {{.ClosedOn}}">closed</span>{{end}}
                        </a>
                    </li>
                {{end}}
            </ul>
        {{else if .Open}}
            <p class="muted">None yet.</p>
        {{else}}
            {{- /* A page on the layout can be served with nothing open -- the
                   restore list is one, deliberately, because nothing-open is the
                   case it exists for. "None yet." would read as an empty
                   checkbook, which is a very different thing. */ -}}
            <p class="muted">No checkbook open.</p>
        {{end}}
        {{- /* An ordinary link, because it goes to a page. The list is beside
               every page, so this is how an account is added from anywhere. It
               is withheld from a checkbook opened read-only rather than offered
               and then refused. */ -}}
        {{if and .Open (not .ReadOnly)}}
            <p class="add-account"><a href="/accounts/new">+ Add account</a></p>
        {{end}}
    </nav>

    {{- /* The second section: what can be done to the checkbook itself, as
           opposed to what is in it. Import, Export and Reconcile land here too.

           Flat named links rather than a File menu. A menubar's keyboard
           semantics are a large surface to build and get right for four items
           (TS-1, TS-4), and naming the items invites only the ones SC-3 lists.

           Back up now is a form and not a link because it does something (BK-2).
           A link would be fired by a prefetch, and the same-origin check in
           control.go would have nothing to read. */ -}}
    {{if .Open}}
    <nav class="checkbook-actions" aria-label="This checkbook">
        <h2>This checkbook</h2>
        {{- /* Withheld for a database held in memory: there is no file to copy,
               and an action that can only be refused is worse than one that is
               not offered. */ -}}
        {{if and (not .Ephemeral) (not .ReadOnly)}}
            <form method="post" action="/backup">
                <input type="hidden" name="return" value="{{.ReturnTo}}">
                <button type="submit" class="action">Back up now</button>
            </form>
        {{end}}
        {{- /* A link, because it goes to a page that asks first (RG-3), and
               beside Back up now because the two are the same operation read
               in opposite directions. Withheld for the sample household, for a
               backup being read, and for a build that cannot open a checkbook:
               in each of those there is no file for a restored copy to
               replace. */ -}}
        {{if .CanRestore}}
            <a class="action" href="/checkbook/restore">Restore a backup</a>
        {{end}}
        {{- /* A link, because it goes to a page that asks first (RG-3). The
               closing itself is the POST on that page. */ -}}
        <a class="action" href="/checkbook/close">Close checkbook</a>
        {{- /* A backup being read cannot be the thing a restore replaces, so the
               action is withheld and the reader is told where it is instead of
               being left at a dead end (RG-4). */ -}}
        {{if .IsBackup}}
            <p class="muted action-note">To work from these records, close this backup. Restoring is offered on the page you land on.</p>
        {{end}}
    </nav>
    {{end}}
    </div>

    <main>
        {{- /* Something that happened to the checkbook rather than to this page:
               a backup written, a checkbook opened. It is in the frame because
               the actions that raise one are in the frame, and any page can be
               the one the reader was on when they pressed. The register's own
               #notice div, below, is a different thing: it is swapped out of
               band when a mark is refused (CO-3). */ -}}
        {{if .Notice}}<p class="notice" role="status">{{.Notice}}</p>{{end}}
        {{template "main" .}}
    </main>
</div>

<footer class="statusbar">
    {{if .Ephemeral}}
        <span title="Sample data held in memory. It is discarded when the program stops, and nothing is written to disk.">
            <span class="temporary-mark" aria-hidden="true">&#8987;</span>
            Database: <code>{{.Database}}</code> &mdash; held in memory, nothing is saved
        </span>
    {{else if .IsBackup}}
        <span title="A backup. It is opened for reading automatically. Close it and restore it to work from these records.">
            <span class="temporary-mark" aria-hidden="true">&#128274;</span>
            Backup: <code>{{.Database}}</code> &mdash; open for reading only
        </span>
    {{else if .ReadOnly}}
        <span title="Opened for reading only. Nothing here can be changed.">
            <span class="temporary-mark" aria-hidden="true">&#128274;</span>
            Database: <code>{{.Database}}</code> &mdash; open for reading only
        </span>
    {{else}}
        <span title="The file holding your records. Back this file up.">Database: <code>{{.Database}}</code></span>
    {{end}}
    <span class="version">v{{.Version}}<a class="repo"
              href="https://github.com/mdhender/mmm/issues"
              target="_blank" rel="noopener noreferrer"
              title="Report a problem with Checkbook on GitHub">
            {{- /*
              The GitHub mark, inline. It is a handful of bytes and a link the
              reader chooses to follow; nothing here is fetched from a CDN or
              contacted by the program itself (PL-3, TS-4).
            */ -}}
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="visually-hidden">Report a problem on GitHub</span>
        </a>
    </span>
</footer>
</body>
</html>
