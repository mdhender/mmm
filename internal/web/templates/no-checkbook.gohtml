{{- /*
  Shown when no database is open: because the reader closed one, or because the
  program was started without one.

  This page stands alone rather than using layout.gohtml, for the same reason
  problem.gohtml does: the frame there is built around the account list and the
  database in use, and here there is neither. An empty sidebar reading "None
  yet." would suggest an empty checkbook, which is a very different thing from
  no checkbook at all.
*/ -}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>No checkbook open &middot; Checkbook</title>
    <link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header class="topbar">
    <span class="brand">Checkbook</span>
</header>

<main class="problem">
    <h1>No checkbook is open</h1>

    {{if .Notice}}<p class="notice" role="status">{{.Notice}}</p>{{end}}
    {{if .Message}}<p class="entry-error" role="alert">{{.Message}}</p>{{end}}

    {{if .Closed}}
        <p class="lead">
            The program is still running, and it is no longer holding your records open.
            <strong>Nothing was changed.</strong>
        </p>
        <dl class="problem-facts">
            <dt>Closed</dt>
            <dd><code>{{.Closed}}</code>{{if .ClosedIsBackup}} &mdash; a backup{{end}}</dd>
        </dl>
        {{if .ClosedIsBackup}}
            {{- /* A backup was being read. Back up now is withheld -- a backup of
                   a backup is not a thing anybody came here for -- and the offer
                   that belongs here is restoring, below, with this file already
                   in the box. */ -}}
            <p>
                That was a backup, opened for reading. It is exactly as you found it. If it is the
                day you want to be back at, <a href="#restore">restore it</a>: that copies it to a
                new file you can open and work in, and leaves the backup itself alone.
            </p>
        {{end}}
        {{if .Copyable}}
            {{- /* The payoff that connects Close to backup. With the file closed
                   there is no write-ahead log beside it to fold back in first,
                   so the single file is the whole checkbook and copying it is
                   safe (BK-4). */ -}}
            <p>
                That file is now safe to copy. It is one file: with the checkbook closed there is
                no <code>-wal</code> beside it waiting to be folded back in.
            </p>
            <form method="post" action="/backup">
                <input type="hidden" name="return" value="/checkbook">
                <button type="submit" class="cta-button">Back up now</button>
            </form>
        {{end}}
    {{else}}
        <p class="lead">
            The program is running and has no records open, so there is no register to show.
        </p>
    {{end}}

    {{if .Problem}}
        {{- /* DescribeOpenError's answer, unchanged: a database from a newer
               release, a file that is not a checkbook, and a missing folder each
               get the heading and the ordered steps they get everywhere else
               (RG-4). */ -}}
        <h2>{{.Problem.Heading}}</h2>
        <dl class="problem-facts">
            <dt>Tried to open</dt>
            <dd><code>{{.Problem.Database}}</code></dd>
        </dl>
        <ol class="steps">
            {{range .Problem.Steps}}<li>{{.}}</li>{{end}}
        </ol>
        <p class="detail"><code>{{.Problem.Detail}}</code></p>
        {{if .Problem.Docs}}
            <ul class="docs">
                {{range .Problem.Docs}}
                    <li>
                        <a href="{{.URL}}">{{.Title}}</a>
                        <span class="muted">&mdash; <code>{{.Path}}</code> in your copy of the project</span>
                    </li>
                {{end}}
            </ul>
        {{end}}
    {{end}}

    {{if .CanOpen}}
        <h2>Open a checkbook</h2>
        <form class="entry account-form" method="post" action="/checkbook/open">
            <div class="entry-fields">
                <label class="f-path">Path
                    <input type="text" name="path" value="{{.Path}}"
                           autocomplete="off" spellcheck="false" placeholder="checkbook.db" autofocus>
                </label>
                {{- /* The box is for a checkbook that could be written to and
                       is not going to be. It is not how a backup is opened: a
                       backup says in its own header what it is, so it is opened
                       read-only whether the box is ticked or not, and nobody
                       has to know what they are holding before they can look at
                       it. Read-only never migrates, which is what makes looking
                       at an older copy safe. */ -}}
                <label class="f-readonly checkbox">
                    <input type="checkbox" name="readonly" value="1"{{if .ReadOnly}} checked{{end}}>
                    Open read-only &mdash; the file cannot be changed
                </label>
                <div class="f-add">
                    <button type="submit">Open</button>
                </div>
            </div>
            <p class="muted entry-note">
                A file that does not exist yet is created as a new, empty checkbook. A folder that
                does not exist is reported rather than made. A backup is opened read-only
                automatically, ticked or not, and nothing is ever written to one.
            </p>
        </form>

        {{- /* Its own form, so the demo cannot be opened by leaving a path in
               the box and pressing the wrong button. */ -}}
        <form method="post" action="/checkbook/open">
            <input type="hidden" name="demo" value="1">
            <button type="submit" class="cta-button">Open the sample household instead</button>
        </form>
        <p class="muted">
            The sample household is held in memory. Nothing is written to disk and it is discarded
            when the program stops.
        </p>
    {{end}}

    {{- /* Outside the CanOpen block, because restoring needs no Opener: it
           writes a third file and swaps nothing, so the route is always
           registered and the offer is always honest. */ -}}
    <h2 id="restore">Restore a backup</h2>
    {{if .RestoreMessage}}<p class="entry-error" role="alert">{{.RestoreMessage}}</p>{{end}}
    <p>
        A backup cannot be opened and worked in &mdash; the moment it were written to it would
        stop being the copy you took. Restoring makes a fresh checkbook out of one instead: it
        copies the backup to a name you choose, brings the copy up to date if it came from an
        older release, and reads it back before giving it that name.
    </p>
    <form class="entry account-form" method="post" action="/checkbook/restore">
        <input type="hidden" name="return" value="/checkbook">
        <div class="entry-fields">
            <label class="f-path">Restore from
                <input type="text" name="source" value="{{.RestoreSource}}"
                       autocomplete="off" spellcheck="false" placeholder="checkbook-20260902-141530.db">
            </label>
            <label class="f-path">Restore to
                <input type="text" name="dest" value="{{.RestoreDest}}"
                       autocomplete="off" spellcheck="false" placeholder="checkbook-restored.db">
            </label>
            <div class="f-add">
                <button type="submit">Restore</button>
            </div>
        </div>
        <p class="muted entry-note">
            The file you restore to must not exist yet. Nothing is ever written over: the file
            you would be replacing is often the one that shows what went wrong. Open the
            restored copy, check the balances, and put it where you keep your records yourself.
        </p>
    </form>

    {{if .CanQuit}}
        <h2>Or stop the program</h2>
        <p><a href="/quit">Quit</a> &mdash; this ends the program. Starting it again reopens the register.</p>
    {{end}}
</main>

<footer class="statusbar">
    <span>No checkbook open</span>
    <span class="version">v{{.Version}}<a class="repo"
              href="https://github.com/mdhender/mmm/issues"
              target="_blank" rel="noopener noreferrer"
              title="Report a problem with Checkbook on GitHub">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="visually-hidden">Report a problem on GitHub</span>
        </a>
    </span>
</footer>
</body>
</html>
