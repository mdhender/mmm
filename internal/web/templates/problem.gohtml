{{- /*
  Served at every address when the database could not be opened.

  This page stands alone rather than using layout.gohtml: the frame there is
  built around the account list, and there is no database to read one from. An
  empty sidebar reading "None yet." would suggest an empty checkbook, which is a
  very different thing from one that could not be opened.
*/ -}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Heading}} &middot; Checkbook</title>
    <link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header class="topbar">
    <span class="brand">Checkbook</span>
</header>

<main class="problem">
    <h1>{{.Heading}}</h1>

    <p class="lead">
        The program is running, but it could not open your records, so there is no register to
        show. <strong>Nothing has been changed.</strong>
    </p>

    <dl class="problem-facts">
        <dt>Database</dt>
        <dd><code>{{.Database}}</code></dd>
    </dl>

    {{- /* RG-4: what happened, then what the reader can safely do next. */ -}}
    <h2>What to do next</h2>
    <ol class="steps">
        {{range .Steps}}
            <li>{{.}}</li>
        {{end}}
    </ol>

    {{if .Docs}}
        <h2>Where to read more</h2>
        <ul class="docs">
            {{range .Docs}}
                <li>
                    <a href="{{.URL}}">{{.Title}}</a>
                    <span class="muted">— <code>{{.Path}}</code> in your copy of the project</span>
                </li>
            {{end}}
        </ul>
    {{end}}

    <h2>The message</h2>
    <p class="detail"><code>{{.Detail}}</code></p>

    <p class="muted">
        Stop the program with Ctrl+C in the terminal it was started from, then start it again once
        the problem above is dealt with.
    </p>
</main>

<footer class="statusbar">
    <span>Database could not be opened</span>
    <span class="version">v{{.Version}}<a class="repo"
              href="https://github.com/mdhender/mmm/issues"
              target="_blank" rel="noopener noreferrer"
              title="Report a problem with Checkbook on GitHub">
            {{- /*
              The GitHub mark, inline. It is a handful of bytes and a link the
              reader chooses to follow; nothing here is fetched from a CDN or
              contacted by the program itself (PL-3, TS-4).
            */ -}}
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span class="visually-hidden">Report a problem on GitHub</span>
        </a>
    </span>
</footer>
</body>
</html>
