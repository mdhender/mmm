{{define "main"}}
    <div class="register-head">
        <h1>{{.Account.Name}}</h1>
        <p class="muted">
            {{.Account.Type}} &middot; {{.Currency}}
            {{- if .Account.IsClosed}} &middot; closed {{.Account.ClosedOn}}{{end}}
        </p>
    </div>

    {{- /* Replaced out of band when a change is refused, so a stale tab is told
           rather than quietly corrected (CO-3). Empty the rest of the time. */ -}}
    <div id="notice">{{if .Notice}}<p class="notice" role="alert">{{.Notice}}</p>{{end}}</div>

    {{if .Rows}}
        <table class="register">
            <caption class="visually-hidden">Transactions for {{.Account.Name}}, oldest first</caption>
            <thead>
            <tr>
                <th scope="col" class="date">Date</th>
                <th scope="col" class="num">Num</th>
                <th scope="col">Payee</th>
                <th scope="col">Category</th>
                <th scope="col">Memo</th>
                <th scope="col" class="money">Amount</th>
                <th scope="col" class="status" title="blank: only in the checkbook. c: the bank has shown it. R: recorded by a reconciliation.">&#10003;</th>
                <th scope="col" class="money">Balance</th>
            </tr>
            </thead>
            <tbody>
            {{range .Rows}}{{template "row" .}}{{end}}
            </tbody>
        </table>
    {{else}}
        <p class="empty">This register has no transactions yet.</p>
    {{end}}

    {{template "totals" .}}

    {{- /* The entry form sits on the register, not behind another click: the
           register is the primary screen (RG-1). It is deliberately outside the
           table's {{if .Rows}}, so an account with no transactions can take its
           first one.

           A plain form POST, with no HTMX and no script. Adding a row changes
           the running balance of every row below it, so there is no part of the
           page to swap and a full re-render is the honest answer. The POST
           redirects, which is what stops a reload entering the same
           transaction twice (SC-4). */ -}}
    <form class="entry" method="post" action="/accounts/{{.Account.ID}}/transactions">
        <h2>Add a transaction</h2>

        {{if .FormError}}
            {{- /* Says what happened and what to do next, like every other
                   failure the program reports (RG-4). */ -}}
            <p class="entry-error" role="alert">{{.FormError}}</p>
        {{end}}

        <div class="entry-fields">
            <label class="f-date">Date
                <input type="text" name="date" value="{{.Form.Date}}"
                       inputmode="numeric" placeholder="YYYY-MM-DD" required>
            </label>
            <label class="f-num">Num
                <input type="text" name="check_number" value="{{.Form.CheckNumber}}" inputmode="numeric">
            </label>
            <label class="f-payee">Payee
                <input type="text" name="payee" value="{{.Form.Payee}}" required>
            </label>
            <label class="f-category">Category
                <input type="text" name="category" value="{{.Form.Category}}"
                       list="category-names" autocomplete="off" placeholder="Uncategorized">
            </label>
            <label class="f-memo">Memo
                <input type="text" name="memo" value="{{.Form.Memo}}">
            </label>
            {{- /* Two boxes, as on a paper register. The box says which way the
                   money went, so no sign is typed and none can be forgotten. */ -}}
            <label class="f-payment">Payment
                <input type="text" name="payment" value="{{.Form.Payment}}"
                       inputmode="decimal" class="money">
            </label>
            <label class="f-deposit">Deposit
                <input type="text" name="deposit" value="{{.Form.Deposit}}"
                       inputmode="decimal" class="money">
            </label>
            <div class="f-add">
                <button type="submit">Add</button>
            </div>

            {{- /* The categories already in use. A datalist suggests without
                   restricting, so a new category is still one keystroke away
                   while a slip that would file this month's shopping under a
                   second spelling of "Groceries" is not. */ -}}
            <datalist id="category-names">
                {{range .Categories}}<option value="{{.}}"></option>{{end}}
            </datalist>
        </div>
        <p class="muted entry-note">
            Amounts are in {{.Currency}}, without a sign. A new entry is uncleared until the bank shows it.
        </p>
    </form>
{{end}}

{{- /* One register row. It is a template of its own because marking a
       transaction cleared answers with this row alone, swapped in place, rather
       than with the whole page. */ -}}
{{define "row"}}
    <tr id="txn-{{.ID}}">
        {{- /* A calendar date is shown exactly as it was entered. It carries no
               timezone and must not be shifted (ST-8, RG-5). */ -}}
        <td class="date">{{.Date}}</td>
        <td class="num">{{.CheckNumber}}</td>
        <td class="payee">{{.Payee}}</td>
        <td class="category{{if .Uncategorized}} muted{{end}}">{{.Category}}</td>
        <td class="memo">{{.Memo}}</td>
        <td class="money{{if .AmountNegative}} negative{{end}}">{{.Amount}}</td>
        <td class="status" title="{{.StatusLabel}}">
            {{if .Reconciled}}
                {{- /* No control: a finished reconciliation is a fact, and the
                       register does not rewrite it (RC-3). */ -}}
                {{.StatusMark}}
            {{else}}
                {{- /* A real form, so the mark still works with no script at all:
                       htmx intercepts it and swaps this row, and without htmx the
                       browser posts it and the handler redirects to the register.
                       The token goes back with the change, so a write from a tab
                       that has gone stale is refused rather than applied (CO-3). */ -}}
                <form method="post" action="/accounts/{{.AccountID}}/transactions/{{.ID}}/status"
                      hx-post="/accounts/{{.AccountID}}/transactions/{{.ID}}/status"
                      hx-target="#txn-{{.ID}}" hx-swap="outerHTML">
                    <input type="hidden" name="status" value="{{.NextStatus}}">
                    <input type="hidden" name="updated_at" value="{{.Token}}">
                    <button type="submit" class="mark" title="{{.ActionLabel}}">
                        <span aria-hidden="true">{{if .StatusMark}}{{.StatusMark}}{{else}}&middot;{{end}}</span>
                        <span class="visually-hidden">{{.ActionLabel}}</span>
                    </button>
                </form>
            {{end}}
        </td>
        <td class="money{{if .BalanceNegative}} negative{{end}}">{{.Balance}}</td>
    </tr>
{{end}}

{{- /* Both balances are shown, and the gap between them is named. The difference
       is the point: it is what a reconciliation has to account for, and hiding it
       would be manufacturing agreement (RC-1, RC-2).

       Marking a row cleared moves the cleared balance and the uncleared count
       but not the ending balance, so the totals come back with the row as an
       out-of-band swap and the two never disagree. */ -}}
{{define "totals"}}
    <dl class="totals" id="totals"{{if .OOB}} hx-swap-oob="true"{{end}}>
        <div>
            <dt>Ending balance</dt>
            <dd class="money{{if .EndingNegative}} negative{{end}}">{{.Ending}} {{.Currency}}</dd>
        </div>
        <div>
            <dt>Cleared balance</dt>
            <dd class="money">{{.Cleared}} {{.Currency}}</dd>
        </div>
        <div>
            <dt>Not yet cleared</dt>
            <dd class="money">{{.Uncleared}} {{.Currency}}
                <span class="muted">({{.UnclearedCount}} transaction{{if ne .UnclearedCount 1}}s{{end}})</span>
            </dd>
        </div>
    </dl>
{{end}}

{{- /* The notice on its own, for an out-of-band swap. */ -}}
{{define "notice"}}
    <div id="notice" hx-swap-oob="true">{{if .Notice}}<p class="notice" role="alert">{{.Notice}}</p>{{end}}</div>
{{end}}
